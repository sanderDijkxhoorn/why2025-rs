# Rust std main thread needs a larger stack than the ESP-IDF default
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16000
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# The badge carries an early ESP32-P4 (rev v1.0)
CONFIG_ESP32P4_REV_MIN_100=y

# PSRAM holds the DPI framebuffer (stock BadgeVMS settings)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y

# WHY2025 P4-to-C6 Wi-Fi link (matches the badge test firmware pinout).
CONFIG_ESP_HOSTED_ENABLED=y
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
CONFIG_ESP_HOSTED_SDIO_SLOT_1=y
CONFIG_ESP_HOSTED_SDIO_SLOT=1
CONFIG_ESP_HOSTED_SDIO_4_BIT_BUS=y
CONFIG_ESP_HOSTED_SDIO_BUS_WIDTH=4
CONFIG_ESP_HOSTED_SDIO_CLOCK_FREQ_KHZ=40000
CONFIG_ESP_HOSTED_SDIO_RESET_ACTIVE_HIGH=y
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CMD_SLOT_1=33
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CLK_SLOT_1=32
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D0_SLOT_1=28
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D1_4BIT_BUS_SLOT_1=31
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D2_4BIT_BUS_SLOT_1=30
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D3_4BIT_BUS_SLOT_1=29
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=13
CONFIG_ESP_HOSTED_SDIO_PIN_CMD=33
CONFIG_ESP_HOSTED_SDIO_PIN_CLK=32
CONFIG_ESP_HOSTED_SDIO_PIN_D0=28
CONFIG_ESP_HOSTED_SDIO_PRIV_PIN_D1_4BIT_BUS=31
CONFIG_ESP_HOSTED_SDIO_PIN_D2=30
CONFIG_ESP_HOSTED_SDIO_PIN_D3=29
CONFIG_ESP_HOSTED_SDIO_PIN_D1=31
CONFIG_ESP_HOSTED_GPIO_SLAVE_RESET_SLAVE=13

CONFIG_ESP_WIFI_REMOTE_ENABLED=y
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
CONFIG_ESP_WIFI_REMOTE_LIBRARY_HOSTED=y
